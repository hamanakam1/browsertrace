		<key>EXTENSION_BACKEND_PORT</key>
		<string>7890</string>
		<key>OLLAMA_ENDPOINT</key>
		<string>http://127.0.0.1:11434/v1</string>
		<key>OLLAMA_MODEL</key>
		<string>qwen3.8-hermes:latest</string>
	</dict>
</dict>
</plist>
